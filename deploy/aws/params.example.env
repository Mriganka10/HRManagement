# Copy to deploy/aws/params.env (git-ignored) and fill in. Used by deploy/aws/deploy.sh.
AWS_REGION=ap-south-1
STACK_NAME=kairoz-hrm
APP_NAME=kairoz-hrm

# Network: an existing VPC. Public subnets host the load balancer; private subnets host the app and RDS.
VPC_ID=vpc-0123456789abcdef0
PUBLIC_SUBNET_IDS=subnet-aaa,subnet-bbb
PRIVATE_SUBNET_IDS=subnet-ccc,subnet-ddd
# Private subnets need a NAT gateway for SES/S3/ECR. Without one, pass public subnets above and set ENABLED.
ASSIGN_PUBLIC_IP=DISABLED

# Domain & email
CERTIFICATE_ARN=arn:aws:acm:ap-south-1:123456789012:certificate/xxxxxxxx
PUBLIC_BASE_URL=https://hr.kairoz.com
EMAIL_FROM="Kairoz HR <hr@kairoz.com>"
BOOTSTRAP_HR_EMAIL=hr.admin@kairoz.com

# Size
DESIRED_COUNT=2
MAX_COUNT=4
DB_INSTANCE_CLASS=db.t4g.small
DB_MULTI_AZ=false

# Optional AI review layer: Secrets Manager ARN of a plain-text API key
LLM_API_KEY_SECRET_ARN=
