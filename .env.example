# Copy this file to .env and adjust. Real environment variables override .env values.

# --- App ---------------------------------------------------------------------
HRM_COMPANY_NAME=Kairoz
# Long random string; generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
HRM_SECRET_KEY=change-me
HRM_PUBLIC_BASE_URL=http://127.0.0.1:8000
# Emails (comma-separated) that open the HR board instead of the candidate app
HRM_HR_EMAILS=hr@example.com

# --- Hiring thresholds (a score equal to the threshold passes) -----------------
HRM_ATS_PASS_SCORE=75
HRM_TEST_PASS_PERCENT=70
HRM_INTERVIEW_PASS_SCORE=75

# --- Assessments ---------------------------------------------------------------
# quick=10, standard=20, full=30 questions
HRM_TEST_LENGTH=standard
# mixed | easy | medium | hard
HRM_TEST_DIFFICULTY=mixed
HRM_TEST_GRACE_SECONDS=60
# quick=5, standard=8, deep=10 questions
HRM_INTERVIEW_MODE=standard
HRM_MAX_RESUME_MB=5

# --- Sign-in -------------------------------------------------------------------
# Shows the OTP on the login screen. MUST be false in production.
HRM_DEV_RETURN_OTP=true
HRM_OTP_TTL_MINUTES=10
HRM_COOKIE_SECURE=false
HRM_SESSION_MAX_AGE_SECONDS=604800

# --- Storage -------------------------------------------------------------------
# Folder for the SQLite database, uploaded resumes and the email outbox
HRM_DATA_DIR=data
# Leave empty for SQLite. Production: postgresql://user:password@host:5432/hr_management
HRM_DATABASE_URL=

# --- Email ---------------------------------------------------------------------
# console = print to terminal + save to data/outbox (default). smtp = send for real.
HRM_EMAIL_BACKEND=console
HRM_SMTP_HOST=
HRM_SMTP_PORT=587
HRM_SMTP_USERNAME=
HRM_SMTP_PASSWORD=
HRM_SMTP_FROM=
HRM_SMTP_USE_TLS=true

# --- Optional LLM layer (everything works without it) ------------------------
# Shared key (OpenAI Responses API compatible). Adds an AI review to ATS and interview scoring
# and generates extra test questions for skills the question bank does not cover.
HRM_LLM_API_KEY=
HRM_LLM_MODEL=gpt-4o-mini
HRM_LLM_ENDPOINT=
HRM_LLM_DAILY_BUDGET_USD=5
HRM_LLM_USER_DAILY_BUDGET_USD=0.25
# Per-feature overrides (fall back to HRM_LLM_API_KEY)
HRM_INTERVIEW_LLM_API_KEY=
HRM_MOCK_TEST_LLM_API_KEY=
HRM_MOCK_TEST_LLM=on

# --- Rate limits ("count/window_seconds"; HRM_RATE_LIMITS=off disables) --------
HRM_RATE_LIMITS=on
HRM_LIMIT_OTP_REQUEST_EMAIL=3/900
HRM_LIMIT_OTP_REQUEST_IP=20/900
HRM_LIMIT_OTP_VERIFY_IP=30/900
