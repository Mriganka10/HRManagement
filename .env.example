# Copy this file to .env for local development. Real environment variables override .env.
# On AWS these come from the ECS task definition and Secrets Manager (see docs/CONFIGURATION.md).

# --- App ------------------------------------------------------------------------
# development | production  (production: forces secure cookies, hides OTPs, disables /docs, requires a secret key)
HRM_ENVIRONMENT=development
HRM_COMPANY_NAME=Kairoz
# Long random string: python -c "import secrets; print(secrets.token_urlsafe(48))"
HRM_SECRET_KEY=change-me
HRM_PUBLIC_BASE_URL=http://127.0.0.1:8000
HRM_TIMEZONE=Asia/Kolkata

# --- First HR administrator (created on start if no HR admin exists) ------------
# e.g. hr.admin@kairoz.com. Locally a temporary password is printed in the terminal when HRM_BOOTSTRAP_HR_PASSWORD is empty.
# Leave empty if you use "seed-demo" (the demo creates its own HR admin, KZH1001).
# Alternative: python -m hr_management create-hr --email you@kairoz.com --name "Your Name"
HRM_BOOTSTRAP_HR_EMAIL=
HRM_BOOTSTRAP_HR_NAME=HR Administrator
HRM_BOOTSTRAP_HR_PASSWORD=

# --- Recruitment pass marks (a score equal to the pass mark passes) ------------
HRM_ATS_PASS_SCORE=75
HRM_TEST_PASS_PERCENT=70
HRM_INTERVIEW_PASS_SCORE=75
# true: passing the interview selects the candidate and emails the onboarding form automatically
# false: passing the interview waits for HR to click Select / Not selected
HRM_AUTO_SELECT=true

# --- Assessments ------------------------------------------------------------------
HRM_TEST_LENGTH=standard          # quick=10, standard=20, full=30 questions
HRM_TEST_DIFFICULTY=mixed         # mixed | easy | medium | hard
HRM_TEST_GRACE_SECONDS=60
HRM_INTERVIEW_MODE=standard       # quick=5, standard=8, deep=10 questions
HRM_MAX_UPLOAD_MB=5

# --- People operations ------------------------------------------------------------
HRM_PROBATION_MONTHS=6
HRM_WORK_WEEK_DAYS=5              # 5 = Mon-Fri, 6 = Mon-Sat
HRM_OFFICE_START_TIME=09:30
HRM_LATE_GRACE_MINUTES=15

# --- Sign-in -------------------------------------------------------------------
# Shows candidate sign-in codes on screen. Always off when HRM_ENVIRONMENT=production.
HRM_DEV_RETURN_OTP=true
HRM_OTP_TTL_MINUTES=10
HRM_SESSION_MAX_AGE_SECONDS=43200
HRM_PASSWORD_MIN_LENGTH=10
HRM_LOGIN_MAX_FAILURES=5
HRM_LOGIN_LOCK_MINUTES=15
HRM_COOKIE_SECURE=false

# --- Database -------------------------------------------------------------------
# Empty = SQLite in data/. Production: PostgreSQL, either a full URL...
HRM_DATABASE_URL=
# ...or parts (how ECS injects the RDS-managed secret)
HRM_DB_HOST=
HRM_DB_PORT=5432
HRM_DB_NAME=hr_management
HRM_DB_USER=
HRM_DB_PASSWORD=
HRM_DB_SSLMODE=require
HRM_DATA_DIR=data

# --- File storage: resumes, receipts, generated documents -------------------------
HRM_STORAGE_BACKEND=local         # local | s3
HRM_S3_BUCKET=
HRM_S3_PREFIX=hrm
HRM_AWS_REGION=ap-south-1

# --- Email ----------------------------------------------------------------------
HRM_EMAIL_BACKEND=console         # console (terminal + data/outbox) | smtp | ses
HRM_EMAIL_FROM=
HRM_SMTP_HOST=
HRM_SMTP_PORT=587
HRM_SMTP_USERNAME=
HRM_SMTP_PASSWORD=
HRM_SMTP_USE_TLS=true

# --- Optional LLM layer (everything works without it) ----------------------------
# OpenAI Responses-API compatible. Adds AI review to ATS/interview scoring, extra test questions,
# and lets the employee assistant plan with the LLM instead of rules.
HRM_LLM_API_KEY=
HRM_LLM_MODEL=gpt-4o-mini
HRM_LLM_ENDPOINT=
HRM_LLM_DAILY_BUDGET_USD=5
HRM_LLM_USER_DAILY_BUDGET_USD=0.25
HRM_INTERVIEW_LLM_API_KEY=
HRM_MOCK_TEST_LLM_API_KEY=
HRM_ASSISTANT_LLM_API_KEY=
HRM_MOCK_TEST_LLM=on

# --- Rate limits ("count/window_seconds"; HRM_RATE_LIMITS=off disables) ------------
HRM_RATE_LIMITS=on
HRM_LIMIT_OTP_REQUEST_EMAIL=3/900
HRM_LIMIT_OTP_REQUEST_IP=20/900
HRM_LIMIT_OTP_VERIFY_IP=30/900
HRM_LIMIT_STAFF_LOGIN_IP=30/900
HRM_LIMIT_ASSISTANT=120/3600
