{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "HR Management (dev server)",
      "type": "debugpy",
      "request": "launch",
      "module": "hr_management",
      "args": ["--reload"],
      "cwd": "${workspaceFolder}",
      "env": { "PYTHONPATH": "${workspaceFolder}/src" },
      "justMyCode": true
    },
    {
      "name": "Tests (pytest)",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["-q"],
      "cwd": "${workspaceFolder}",
      "justMyCode": false
    }
  ]
}
